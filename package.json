{
  "name": "sage-ade",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --mode desktop-native && node scripts/write-web-build-receipt.mjs desktop-native",
    "test": "vitest run --exclude tests/ui/**/*.spec.ts",
    "test:ui": "playwright test --config playwright.config.ts",
    "test:ui:update": "playwright test --config playwright.config.ts --update-snapshots",
    "test:budgets": "node scripts/budget-lanes.mjs --check",
    "test:web-bundle": "node scripts/verify-web-bundle.mjs",
    "test:budgets:portable": "node scripts/budget-lanes.mjs --lane portable",
    "test:budgets:windows": "node scripts/budget-lanes.mjs --lane windows",
    "test:budgets:posix": "node scripts/budget-lanes.mjs --lane posix",
    "test:budgets:posix:linux": "node scripts/budget-lanes.mjs --lane posix-linux",
    "test:budgets:posix:darwin": "node scripts/budget-lanes.mjs --lane posix-darwin",
    "test:budgets:inventory": "node --test --test-concurrency=1 scripts/budget-lanes.node-test.mjs",
    "test:native-lane": "node scripts/native-lane.mjs",
    "test:cdp-lane": "cargo test -p sage --features cdp-lane --lib browser::devtools",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fixture-privacy": "node scripts/check-harness-trace-privacy.mjs",
    "check:policy": "node scripts/generate-acp-fixture-cases.mjs --check && node --test scripts/check-harness-trace-privacy.node-test.mjs scripts/check-policy.node-test.mjs scripts/browser-test-policy.node-test.mjs && node scripts/check-harness-trace-privacy.mjs && node scripts/check-policy.mjs",
    "check:dev": "node scripts/check-dev.mjs",
    "check:integration": "node scripts/check-integration.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run test:budgets && npm run build && npm run test:web-bundle && npm run check:policy",
    "gate:static": "node scripts/gate.mjs static",
    "gate:fast": "node scripts/gate.mjs fast",
    "gate:rust": "node scripts/gate.mjs rust",
    "gate:full": "node scripts/gate.mjs full",
    "gate:changed": "node scripts/gate.mjs changed",
    "lane": "node scripts/lane.mjs",
    "smoke": "node scripts/app-smoke.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "2.11.1",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.27.0",
    "markdown-it": "15.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "style-mod": "4.1.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
