{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sage Footprint Control",
  "version": "0.1.0",
  "identifier": "ai.sage.footprint-control",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sage Footprint Control",
        "width": 1380,
        "height": 880,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost http://tauri.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "frame-src": "'self' http://127.0.0.1:* https://127.0.0.1:*"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": ["../../src-tauri/icons/icon.ico"],
    "resources": [],
    "shortDescription": "Disposable Sage footprint control."
  }
}
