{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sage",
        "width": 1380,
        "height": 880,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#141414",
        "visible": true
      }
    ],
    "security": { "capabilities": ["main", "main-window-controls"] }
  },
  "bundle": {
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
