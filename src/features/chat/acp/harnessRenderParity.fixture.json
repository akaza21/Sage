  "notApplicable": [
    {
      "scenario": "commandWithOutput",
      "harness": "pi",
      "reason": "Sage's Pi bridge refuses every shell command, so Pi never runs one."
    },
    {
      "scenario": "planUpdate",
      "harness": "pi",
      "reason": "Pi has no plan or todo tool."
    }
  ],
