{
  "scenarios": {
    "thinkingThenLinkedText": {
      "title": "Thinking, then an answer with a markdown link",
      "projection": {
        "turnState": "completed",
        "items": [
          {
            "lifecycle": "completed",
            "toolState": null,
            "kind": "thoughtSummary",
            "payload": {
              "summary": "Checking the guide."
            }
          },
          {
            "lifecycle": "completed",
            "toolState": null,
            "kind": "text",
            "payload": {
              "role": "assistant",
              "text": "See [the guide](https://example.com/guide)."
            }
          }
        ]
      },
      "outline": [
        "status \"Completed\"",
        "  Completed",
        "  Worked for 0s",
        "article",
        "  Agent",
        "  See",
        "web link -> https://example.com/guide",
        "  the guide",
        "  ."
      ]
    },
    "toolCompletes": {
      "title": "A file read that completes",
      "projection": {
        "turnState": "completed",
        "items": [
          {
            "lifecycle": "completed",
            "toolState": "completed",
            "kind": "toolCall",
            "payload": {
              "presentation": {
                "kind": "read",
                "label": "Read src/lib.rs",
                "resources": [
                  {
                    "kind": "resource",
                    "resource": {
                      "rootId": "root-1",
                      "relativePath": "src/lib.rs"
                    }
                  }
                ]
              },
              "inputSummary": null,
              "outputSummary": "pub fn answer() -> u32 {\n    41\n}\n"
            }
          }
        ]
      },
      "outline": [
        "status \"Completed\"",
        "  Completed",
        "summary",
        "  Worked for 0s",
        "summary \"Read lib.rs, Completed, 1s\"",
        "  Read lib.rs",
        "group \"Read src/lib.rs\"",
        "note",
        "  Read",
        "  pub fn answer() -> u32 { 41 }",
        "status",
        "  ✓ Success",
        "list \"Referenced resources\"",
        "listitem",
        "  lib.rs"
      ]
    },
