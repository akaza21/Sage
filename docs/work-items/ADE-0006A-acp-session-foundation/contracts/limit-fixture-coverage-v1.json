  "derivedBoundaryExceptions": [
    {
      "limit": "wire.modelsOrConfigBytes",
      "reason": "128 model entries with a 512-byte ID and 512-byte name exactly derive the 131072-byte aggregate; the plus-one shape also has 129 entries, and production rejects the entry count first",
      "errorPrecedence": "entry-count-before-aggregate-model-bytes"
    },
    {
      "limit": "queues.egressFrames",
      "reason": "the total is exactly the 56-frame data partition plus the 8-frame control partition",
      "errorPrecedence": "control-partition-count-before-unreachable-total"
    },
    {
      "limit": "queues.egressBytes",
      "reason": "the total is exactly the 1835008-byte data partition plus the 262144-byte control partition",
      "errorPrecedence": "data-partition-bytes-before-unreachable-total"
    },
    {
      "limit": "queues.journalBatches",
      "reason": "the total is exactly the 120-batch data partition plus the 8-batch control partition",
      "errorPrecedence": "control-partition-count-before-unreachable-total"
    },
    {
      "limit": "queues.journalBytes",
      "reason": "the total is exactly the 3932160-byte data partition plus the 262144-byte control partition",
      "errorPrecedence": "data-partition-bytes-before-unreachable-total"
    },
    {
      "limit": "process.windowsJobActiveProcessLimit",
      "reason": "the 33-process Job limit is one root process plus the 32-descendant partition; this remains a Windows Job-object proof and is not claimed by the portable observer registry",
      "errorPrecedence": "external-windows-job-enforcement"
    }
  ],
  "reservedLaneProofs": [
    "egress-data-cannot-consume-control-reserve",
    "journal-data-cannot-consume-control-reserve",
    "cancel-dispatch-at-capacity",
    "permission-decline-queue-failure"
  ],
  "otherNumericClasses": {
    "deadlines": "exact monotonic deadline and deadline-plus-one completion cases, not capacity allocation pairs",
    "durableAndMigration": "literal LIMIT+1 SQL/corrupt-database tests generated from the path-keyed limits ledger in C0-I; they do not execute in the child wire fixture",
    "evidenceRetention": "validator unit tests create exact retained file/byte sets and reject the next allocation",
    "operationalFeatureValues": "policy assertions, not numeric capacity pairs",
    "performanceSamples": "measurement protocol cardinalities, not runtime acceptance limits"
  }
