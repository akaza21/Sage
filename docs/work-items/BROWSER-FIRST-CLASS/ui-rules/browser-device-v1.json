      "selector": "input[aria-label='Width']",
      "measure": "height",
      "expected": 21,
      "tolerancePx": 1
    },
    {
      "id": "device-field-fill",
      "ref": "reference/41",
      "source": "BF-7a measured the size field fill rgb(36, 36, 36)",
      "selector": "input[aria-label='Height']",
      "measure": "background-color",
      "expected": "rgb(36, 36, 36)"
    },
    {
      "id": "device-width-left-of-height",
      "ref": "reference/41",
      "source": "BF-7a the width field (x1241) sits left of the height field (x1321) with × between",
      "selector": "input[aria-label='Width']",
      "measure": "left-of",
