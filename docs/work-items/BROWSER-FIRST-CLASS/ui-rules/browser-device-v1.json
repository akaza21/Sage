{
  "schemaVersion": 1,
  "fixture": "/tests/ui/fixtures/browser-device.html",
  "viewport": {
    "width": 1280,
    "height": 1000
  },
  "rules": [
    {
      "id": "device-toolbar-height",
      "ref": "reference/41",
      "source": "BF-7a measured the device bar y137-171 under the address bar's divider, then its own 1 px divider at y172 (36 px)",
      "selector": ".browser-device-toolbar",
      "measure": "height",
      "expected": 36,
      "tolerancePx": 1
    },
    {
      "id": "device-toolbar-under-address-bar",
      "ref": "reference/41",
      "source": "BF-7a the device bar starts right under the 44 px address toolbar",
      "selector": ".browser-device-toolbar",
      "measure": "gap-below",
      "other": ".browser-surface__toolbar",
      "expected": 0,
      "tolerancePx": 0
    },
    {
      "id": "device-toolbar-fill",
      "ref": "reference/41",
      "source": "BF-7a measured the device bar fill rgb(24, 24, 24), the toolbar's own fill",
      "selector": ".browser-device-toolbar",
      "measure": "background-color",
      "expected": "rgb(24, 24, 24)"
    },
    {
      "id": "device-width-field-width",
      "ref": "reference/41",
      "source": "BF-7a measured the width field x1241-1300 (60 px)",
      "selector": "input[aria-label='Width']",
      "measure": "width",
      "expected": 60,
      "tolerancePx": 1
    },
    {
      "id": "device-width-field-height",
